# ---- GameVault API (.env) ----
# Copy to server/.env and fill in. NEVER commit .env. NEVER put secrets in VITE_ vars.

PORT=3001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# MySQL (local service MySQL80). Create the user/db first, e.g. in Workbench:
#   CREATE DATABASE gamevault CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'gv'@'localhost' IDENTIFIED BY 'a-strong-password';
#   GRANT ALL PRIVILEGES ON gamevault.* TO 'gv'@'localhost';
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=gamevault
DATABASE_USER=gv
DATABASE_PASSWORD=change-me

# Random 32+ char string: generate with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=change-me-to-a-random-string

# Stripe secret key: sk_test_... for development, sk_live_... for production.
# The server reports the mode at GET /api/health. LIVE SAFETY: in live mode
# demo_test products can't be bought or fulfilled (see docs/GO_LIVE.md).
# Dashboard: https://dashboard.stripe.com/apikeys (toggle Test / Live).
STRIPE_SECRET_KEY=
# Webhook signing secret for the /api/webhooks/stripe endpoint (whsec_...).
# Test: `stripe listen --forward-to localhost:3001/api/webhooks/stripe`.
# Live: Dashboard → Developers → Webhooks → Add endpoint (your https domain).
STRIPE_WEBHOOK_SECRET=
# Set to true behind real HTTPS in production (required for live).
COOKIE_SECURE=false

# AES-256-GCM key for real code inventory at rest (64 hex chars). Generate
# once with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`,
# back it up securely (losing it orphans every imported code), never commit it.
CODES_ENCRYPTION_KEY=change-me-to-64-hex-chars
